# ---- Core
ENVIRONMENT=development            # production enforces a real SECRET_KEY
SECRET_KEY=change-me-in-production-please-32b
# Fernet key for encrypting connector credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
DATABASE_URL=postgresql+psycopg://fbi:fbi@localhost:5432/fbi
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=thread                # thread (dev) | celery (prod, docker-compose) | inline (tests)
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true                     # enables the clearly-labelled synthetic MockConnector
EXPORTER_ORIGIN_COUNTRY=TR
# Optional first admin user created on startup
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Data providers (all optional; can also be set per organisation in the Source Manager UI)
BRAVE_SEARCH_API_KEY=              # P0 licensed web search
SERPAPI_API_KEY=                   # P0 licensed web search (Google results)
GOOGLE_PLACES_API_KEY=             # P0 Places API (New) — billing account required
COMPANIES_HOUSE_API_KEY=           # P2 UK registry (free key)
HUNTER_API_KEY=                    # P3 contact enrichment (paid beyond free tier)
APOLLO_API_KEY=                    # P3 (connector pending licence/adapter)
# Public Overpass is fair-use only (capped per job). Use your own instance for volume.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_PUBLIC_MAX_QUERIES_PER_JOB=25

# ---- LLM (optional; used only for term expansion, never as a source of companies)
LLM_PROVIDER=none                  # none | anthropic | openai
LLM_MODEL=claude-opus-5-5
LLM_FALLBACK_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Website enrichment
HTTP_USER_AGENT=GlobalBuyerIntelBot/0.1 (+https://your-domain.example/bot; B2B research)
WEBSITE_MAX_PAGES=4
